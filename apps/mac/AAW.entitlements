<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The microphone, which the agent panel listens through, under the
	     hardened runtime a Developer ID signs with. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Memory made executable at run time, for the real-time devices of
	     the person's own, WebAssembly that wasmtime compiles to machine
	     code; the hardened runtime refuses it otherwise. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
