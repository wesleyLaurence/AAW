{
  "$defs": {
    "AudioClip": {
      "additionalProperties": false,
      "properties": {
        "sample": {
          "title": "Sample",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": 0,
          "title": "At"
        },
        "source_start_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Source Start Seconds",
          "type": "number"
        },
        "source_end_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source End Seconds"
        },
        "lead_ms": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Lead Ms",
          "type": "number"
        },
        "gain_db": {
          "default": 0,
          "maximum": 24,
          "minimum": -96,
          "title": "Gain Db",
          "type": "number"
        },
        "fade_in_ms": {
          "default": 0.3,
          "maximum": 10000,
          "minimum": 0,
          "title": "Fade In Ms",
          "type": "number"
        },
        "fade_out_ms": {
          "default": 8,
          "maximum": 10000,
          "minimum": 0,
          "title": "Fade Out Ms",
          "type": "number"
        },
        "fade_curve": {
          "default": "equal_power",
          "enum": [
            "equal_power",
            "linear"
          ],
          "title": "Fade Curve",
          "type": "string"
        },
        "source_bpm": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 20,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Bpm"
        },
        "stretch": {
          "default": "repitch",
          "enum": [
            "repitch",
            "preserve_pitch"
          ],
          "title": "Stretch",
          "type": "string"
        }
      },
      "required": [
        "sample"
      ],
      "title": "AudioClip",
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": 0,
          "title": "At"
        },
        "repeats": {
          "default": 1,
          "maximum": 10000,
          "minimum": 1,
          "title": "Repeats",
          "type": "integer"
        },
        "velocity_scale": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Velocity Scale",
          "type": "number"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "Clip",
      "type": "object"
    },
    "Compressor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "compressor",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "threshold_db": {
          "maximum": 0,
          "minimum": -60,
          "title": "Threshold Db",
          "type": "number"
        },
        "ratio": {
          "default": 4,
          "maximum": 20,
          "minimum": 1,
          "title": "Ratio",
          "type": "number"
        },
        "attack_ms": {
          "default": 10,
          "maximum": 500,
          "minimum": 0,
          "title": "Attack Ms",
          "type": "number"
        },
        "release_ms": {
          "default": 120,
          "maximum": 5000,
          "minimum": 1,
          "title": "Release Ms",
          "type": "number"
        },
        "knee_db": {
          "default": 6,
          "maximum": 24,
          "minimum": 0,
          "title": "Knee Db",
          "type": "number"
        },
        "makeup_db": {
          "default": 0,
          "maximum": 24,
          "minimum": -24,
          "title": "Makeup Db",
          "type": "number"
        },
        "sidechain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sidechain"
        },
        "bypass": {
          "default": false,
          "title": "Bypass",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "threshold_db"
      ],
      "title": "Compressor",
      "type": "object"
    },
    "Delay": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "delay",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "time_beats": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Time Beats"
        },
        "feedback_percent": {
          "default": 35,
          "maximum": 95,
          "minimum": 0,
          "title": "Feedback Percent",
          "type": "number"
        },
        "lowcut_hz": {
          "anyOf": [
            {
              "maximum": 20000,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lowcut Hz"
        },
        "highcut_hz": {
          "anyOf": [
            {
              "maximum": 20000,
              "minimum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highcut Hz"
        },
        "ping_pong": {
          "default": false,
          "title": "Ping Pong",
          "type": "boolean"
        },
        "mix_percent": {
          "default": 100,
          "maximum": 100,
          "minimum": 0,
          "title": "Mix Percent",
          "type": "number"
        },
        "bypass": {
          "default": false,
          "title": "Bypass",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "time_beats"
      ],
      "title": "Delay",
      "type": "object"
    },
    "Eq": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "eq",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "bands": {
          "items": {
            "$ref": "#/$defs/EqBand"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Bands",
          "type": "array"
        },
        "bypass": {
          "default": false,
          "title": "Bypass",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "bands"
      ],
      "title": "Eq",
      "type": "object"
    },
    "EqBand": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "bell",
            "low_shelf",
            "high_shelf"
          ],
          "title": "Shape",
          "type": "string"
        },
        "freq_hz": {
          "maximum": 20000,
          "minimum": 20,
          "title": "Freq Hz",
          "type": "number"
        },
        "gain_db": {
          "maximum": 24,
          "minimum": -24,
          "title": "Gain Db",
          "type": "number"
        },
        "q": {
          "default": 0.71,
          "maximum": 18,
          "minimum": 0.1,
          "title": "Q",
          "type": "number"
        }
      },
      "required": [
        "shape",
        "freq_hz",
        "gain_db"
      ],
      "title": "EqBand",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "At"
        },
        "pad": {
          "title": "Pad",
          "type": "string"
        },
        "velocity": {
          "default": 100,
          "maximum": 127,
          "minimum": 1,
          "title": "Velocity",
          "type": "integer"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "duration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "transpose": {
          "default": 0,
          "maximum": 36,
          "minimum": -36,
          "title": "Transpose",
          "type": "number"
        }
      },
      "required": [
        "at",
        "pad"
      ],
      "title": "Event",
      "type": "object"
    },
    "Filter": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "filter",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "mode": {
          "enum": [
            "highpass",
            "lowpass"
          ],
          "title": "Mode",
          "type": "string"
        },
        "cutoff_hz": {
          "maximum": 20000,
          "minimum": 10,
          "title": "Cutoff Hz",
          "type": "number"
        },
        "slope_db_per_octave": {
          "default": 12,
          "enum": [
            12,
            24,
            36,
            48
          ],
          "title": "Slope Db Per Octave",
          "type": "integer"
        },
        "bypass": {
          "default": false,
          "title": "Bypass",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "mode",
        "cutoff_hz"
      ],
      "title": "Filter",
      "type": "object"
    },
    "Instrument": {
      "additionalProperties": false,
      "properties": {
        "sampler": {
          "$ref": "#/$defs/Sampler"
        }
      },
      "required": [
        "sampler"
      ],
      "title": "Instrument",
      "type": "object"
    },
    "Lane": {
      "additionalProperties": false,
      "description": "Automation for one parameter. It overrides the static value for the whole song.",
      "properties": {
        "param": {
          "title": "Param",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "param",
        "points"
      ],
      "title": "Lane",
      "type": "object"
    },
    "Limiter": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "limiter",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "ceiling_db": {
          "default": -1,
          "maximum": -0.1,
          "minimum": -24,
          "title": "Ceiling Db",
          "type": "number"
        },
        "release_ms": {
          "default": 60,
          "maximum": 2000,
          "minimum": 1,
          "title": "Release Ms",
          "type": "number"
        },
        "lookahead_ms": {
          "default": 3,
          "maximum": 20,
          "minimum": 0.5,
          "title": "Lookahead Ms",
          "type": "number"
        },
        "bypass": {
          "default": false,
          "title": "Bypass",
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "title": "Limiter",
      "type": "object"
    },
    "Master": {
      "additionalProperties": false,
      "properties": {
        "effects": {
          "items": {
            "discriminator": {
              "mapping": {
                "compressor": "#/$defs/Compressor",
                "delay": "#/$defs/Delay",
                "eq": "#/$defs/Eq",
                "filter": "#/$defs/Filter",
                "limiter": "#/$defs/Limiter",
                "reverb": "#/$defs/Reverb"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Filter"
              },
              {
                "$ref": "#/$defs/Eq"
              },
              {
                "$ref": "#/$defs/Compressor"
              },
              {
                "$ref": "#/$defs/Limiter"
              },
              {
                "$ref": "#/$defs/Delay"
              },
              {
                "$ref": "#/$defs/Reverb"
              }
            ]
          },
          "maxItems": 32,
          "title": "Effects",
          "type": "array"
        },
        "automation": {
          "items": {
            "$ref": "#/$defs/Lane"
          },
          "maxItems": 64,
          "title": "Automation",
          "type": "array"
        }
      },
      "title": "Master",
      "type": "object"
    },
    "MidiTrack": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "midi",
          "title": "Type",
          "type": "string"
        },
        "gain_db": {
          "default": 0,
          "maximum": 24,
          "minimum": -96,
          "title": "Gain Db",
          "type": "number"
        },
        "pan": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Pan",
          "type": "number"
        },
        "mute": {
          "default": false,
          "title": "Mute",
          "type": "boolean"
        },
        "solo": {
          "default": false,
          "title": "Solo",
          "type": "boolean"
        },
        "instrument": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instrument"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the notes play; null plays nothing and keeps the notes.",
          "title": "Instrument"
        },
        "clips": {
          "items": {
            "$ref": "#/$defs/NoteClip"
          },
          "title": "Clips",
          "type": "array"
        },
        "effects": {
          "items": {
            "discriminator": {
              "mapping": {
                "compressor": "#/$defs/Compressor",
                "delay": "#/$defs/Delay",
                "eq": "#/$defs/Eq",
                "filter": "#/$defs/Filter",
                "limiter": "#/$defs/Limiter",
                "reverb": "#/$defs/Reverb"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Filter"
              },
              {
                "$ref": "#/$defs/Eq"
              },
              {
                "$ref": "#/$defs/Compressor"
              },
              {
                "$ref": "#/$defs/Limiter"
              },
              {
                "$ref": "#/$defs/Delay"
              },
              {
                "$ref": "#/$defs/Reverb"
              }
            ]
          },
          "maxItems": 32,
          "title": "Effects",
          "type": "array"
        },
        "sends": {
          "items": {
            "$ref": "#/$defs/Send"
          },
          "maxItems": 16,
          "title": "Sends",
          "type": "array"
        },
        "automation": {
          "items": {
            "$ref": "#/$defs/Lane"
          },
          "maxItems": 64,
          "title": "Automation",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "MidiTrack",
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique in its clip. Left out, the next free nN is given when the song is validated.",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "pitch": {
          "anyOf": [
            {
              "maximum": 127,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "description": "A MIDI number, 0 to 127, or a note name such as C4, which is 60 and is stored as its number.",
          "title": "Pitch"
        },
        "at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Beats from the clip's start. A note before it, at a negative at, or at or after its end is kept and does not play.",
          "title": "At"
        },
        "duration": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Beats, more than 0.",
          "title": "Duration"
        },
        "velocity": {
          "default": 100,
          "maximum": 127,
          "minimum": 1,
          "title": "Velocity",
          "type": "integer"
        }
      },
      "required": [
        "pitch",
        "duration"
      ],
      "title": "Note",
      "type": "object"
    },
    "NoteClip": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique among the song's note clips. Left out, the next free clipN is given when the song is validated.",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": 0,
          "description": "The song beat the clip starts on.",
          "title": "At"
        },
        "length_beats": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "More than 0. A note is cut off at the clip's end, and one that starts at or after it does not play.",
          "title": "Length Beats"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/Note"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "length_beats"
      ],
      "title": "NoteClip",
      "type": "object"
    },
    "NoteMap": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "anyOf": [
            {
              "maximum": 127,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "maximum": 127,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          ],
          "description": "A note, or [LOW, HIGH] for an inclusive range, as numbers or names. Entries may not overlap.",
          "title": "Notes"
        },
        "pad": {
          "title": "Pad",
          "type": "string"
        },
        "pitched": {
          "default": false,
          "description": "Plays the pad at the note's pitch, repitched from its sample's root_note; otherwise the pad plays as it is.",
          "title": "Pitched",
          "type": "boolean"
        }
      },
      "required": [
        "notes",
        "pad"
      ],
      "title": "NoteMap",
      "type": "object"
    },
    "Pad": {
      "additionalProperties": false,
      "properties": {
        "sample": {
          "title": "Sample",
          "type": "string"
        },
        "mode": {
          "default": "one_shot",
          "enum": [
            "one_shot",
            "gate"
          ],
          "title": "Mode",
          "type": "string"
        },
        "gain_db": {
          "default": 0,
          "maximum": 24,
          "minimum": -96,
          "title": "Gain Db",
          "type": "number"
        },
        "pan": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Pan",
          "type": "number"
        },
        "transpose": {
          "default": 0,
          "maximum": 36,
          "minimum": -36,
          "title": "Transpose",
          "type": "number"
        },
        "start_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Seconds"
        },
        "attack_ms": {
          "default": 0.3,
          "maximum": 10000,
          "minimum": 0,
          "title": "Attack Ms",
          "type": "number"
        },
        "release_ms": {
          "default": 8,
          "maximum": 10000,
          "minimum": 0,
          "title": "Release Ms",
          "type": "number"
        },
        "choke_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choke Group"
        },
        "reverse": {
          "default": false,
          "title": "Reverse",
          "type": "boolean"
        },
